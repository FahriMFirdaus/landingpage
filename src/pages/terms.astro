---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getTerms } from '../lib/api';

const terms = await getTerms();
const title = terms?.title || 'Syarat & Ketentuan';
const rawContent = terms?.content || 'Syarat & Ketentuan belum diatur oleh admin.';

function formatContent(text: string) {
  if (!text) return '';
  if (/<[a-z][\s\S]*>/i.test(text)) {
    return text;
  }
  return text
    .split(/\n\n+/)
    .map(p => `<p class="mb-4">${p.replace(/\n/g, '<br />')}</p>`)
    .join('');
}

const content = formatContent(rawContent);
---

<Layout title={`${title} - Gampang Beres`}>
  <Navbar />
  <main class="pt-32 pb-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 id="legal-title" class="text-4xl font-extrabold text-slate-900 mb-8">{title}</h1>
      <div class="prose prose-slate max-w-none prose-headings:text-slate-900 prose-p:text-slate-600 prose-li:text-slate-600">
        <div id="legal-content" set:html={content} />
      </div>
    </div>
  </main>
  <Footer />

  <script>
    import { getTerms } from '../lib/api';

    function formatText(text: string) {
      if (!text) return '';
      if (/<[a-z][\s\S]*>/i.test(text)) {
        return text;
      }
      return text
        .split(/\n\n+/)
        .map(p => `<p class="mb-4">${p.replace(/\n/g, '<br />')}</p>`)
        .join('');
    }

    async function loadTerms() {
      try {
        const terms = await getTerms();
        if (terms) {
          const titleEl = document.getElementById('legal-title');
          const contentEl = document.getElementById('legal-content');
          if (titleEl && terms.title) {
            titleEl.textContent = terms.title;
            document.title = `${terms.title} - Gampang Beres`;
          }
          if (contentEl && terms.content) {
            contentEl.innerHTML = formatText(terms.content);
          }
        }
      } catch (e) {
        console.error('Gagal memuat Syarat & Ketentuan terbaru:', e);
      }
    }

    loadTerms();
  </script>
</Layout>

