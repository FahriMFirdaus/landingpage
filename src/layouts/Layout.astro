---
import SplashScreen from '../components/SplashScreen.astro';

interface Props {
	title: string;
	description?: string;
	image?: string;
}

const { 
	title, 
	description = "Gampang Beres - Semua Tagihan & Isi Ulang dalam Satu Aplikasi!",
	image = "/images/logo/logo-nobg.webp"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://gampangberes.biz.id');
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		
		<!-- Google Site Verification -->
		<meta name="google-site-verification" content="qyNKb8JxihJFR2oSR2UeuZ7Eyk_i1CPA4xf9WXliM20" />

		<!-- Canonical URL -->
		<link rel="canonical" href={canonicalURL} />
		
		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="keywords" content="Gampang Beres, Aplikasi PPOB, Pulsa Murah, Bayar Tagihan, Agen Pulsa, Token Listrik, Top Up Game" />
		<meta name="author" content="Gampang Beres" />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(image, canonicalURL)} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalURL} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={new URL(image, canonicalURL)} />
		
		<!-- Performance Optimizations -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		
		<!-- API Connectivity Optimization -->
		<link rel="preconnect" href="https://api.gampangberes.biz.id" crossorigin>
		<link rel="dns-prefetch" href="https://api.gampangberes.biz.id">
		<link rel="preload" href="https://api.gampangberes.biz.id/api/app-status" as="fetch" crossorigin fetchpriority="high">
		
		<!-- Preload Critical Assets -->
		<link rel="preload" as="image" href="/images/logo/logo-nobg.webp" type="image/webp" fetchpriority="high">
		
		<!-- Optimized Font Loading -->
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
		<noscript>
			<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
		</noscript>

		<style is:global>
			:root {
				--accent: 136, 58, 234;
				--accent-light: 224, 204, 250;
				--accent-dark: 49, 10, 101;
				--accent-gradient: linear-gradient(
					45deg,
					rgb(var(--accent)),
					rgb(var(--accent-light)) 30%,
					white 60%
				);
			}
			html {
				font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
				background: #FFFFFF;
				scroll-behavior: smooth;
			}
		</style>
	</head>
	<body class="antialiased text-slate-900">
		<SplashScreen />
		<slot />

		<!-- 
		  REALTIME DATA UPDATER
		  Script ini berjalan di background dan memperbarui semua data dinamis
		  (nomor WA, link download, versi, status server) setiap 60 detik.
		  Ini memastikan perubahan dari dashboard admin langsung tampil di halaman
		  tanpa user harus refresh manual.
		-->
		<script>
		  import { getAppStatus, invalidateAppStatusCache, checkServerHealth } from '../lib/api';

		  /** Update indikator status server dengan pengecekan nyata ke server */
		  async function updateServerStatus() {
		    const statusIndicator = document.getElementById('server-status-indicator');
		    const statusText = document.getElementById('server-status-text');
		    const responseTimeEl = document.getElementById('server-response-time');

		    if (!statusIndicator || !statusText) return;

		    // Tampilkan state "sedang memeriksa" dulu (abu-abu berputar)
		    statusIndicator.className = 'w-2 h-2 rounded-full bg-slate-400 animate-ping';
		    statusText.textContent = 'Memeriksa...';
		    statusText.className = 'text-sm font-semibold text-slate-400';

		    const { status, latencyMs } = await checkServerHealth();

		    // Reset class dulu
		    statusIndicator.classList.remove('animate-ping', 'bg-slate-400', 'bg-slate-500', 'bg-green-500', 'bg-yellow-500', 'bg-red-500', 'animate-pulse');

		    if (status === 'online') {
		      statusIndicator.classList.add('bg-green-500', 'animate-pulse');
		      statusText.textContent = 'Server: Online';
		      statusText.className = 'text-sm font-semibold text-green-400';
		      if (responseTimeEl && latencyMs !== null) {
		        // Warna latensi: hijau < 300ms, kuning 300-800ms, merah > 800ms
		        const latencyColor = latencyMs < 300 ? 'text-green-500' : latencyMs < 800 ? 'text-yellow-500' : 'text-red-400';
		        responseTimeEl.innerHTML = `Latensi: <span class="${latencyColor} font-semibold">${latencyMs} ms</span>`;
		        responseTimeEl.classList.remove('hidden');
		      }
		    } else if (status === 'maintenance') {
		      statusIndicator.classList.add('bg-yellow-500');
		      statusText.textContent = 'Server: Maintenance';
		      statusText.className = 'text-sm font-semibold text-yellow-400';
		      if (responseTimeEl) responseTimeEl.classList.add('hidden');
		    } else {
		      // offline
		      statusIndicator.classList.add('bg-red-500');
		      statusText.textContent = 'Server: Offline ⚠️';
		      statusText.className = 'text-sm font-semibold text-red-400';
		      if (responseTimeEl) {
		        responseTimeEl.innerHTML = 'Tidak dapat menghubungi server';
		        responseTimeEl.className = 'text-xs text-red-500 pl-5';
		        responseTimeEl.classList.remove('hidden');
		      }
		    }
		  }

		  /** Update semua elemen dinamis di halaman dengan data terbaru */
		  async function syncDynamicData(forceRefresh = false) {
		    if (forceRefresh) invalidateAppStatusCache();

		    try {
		      const appStatus = await getAppStatus();
		      if (!appStatus) return;

		      // ── Download URL ──────────────────────────────────────────────────
		      if (appStatus.download_url) {
		        const downloadIds = [
		          'hero-download-link',
		          'bottom-download-link',
		          'navbar-download-link',
		          'desktop-download-link',
		          'mobile-download-link',
		          'manual-download-link',
		        ];
		        downloadIds.forEach(id => {
		          const el = document.getElementById(id) as HTMLAnchorElement | null;
		          if (el) el.href = appStatus.download_url;
		        });
		      }

		      // ── WhatsApp / CS Link ────────────────────────────────────────────
		      if (appStatus.contact_whatsapp) {
		        const waIds = ['hero-whatsapp-link', 'footer-whatsapp-link'];
		        waIds.forEach(id => {
		          const el = document.getElementById(id) as HTMLAnchorElement | null;
		          if (el) el.href = appStatus.contact_whatsapp;
		        });
		      }

		      // ── Versi Aplikasi ────────────────────────────────────────────────
		      if (appStatus.latest_version) {
		        const versionIds = ['hero-version-text', 'footer-version', 'latest-version'];
		        const versionBadge = document.getElementById('hero-version-badge');

		        versionIds.forEach(id => {
		          const el = document.getElementById(id);
		          if (el) {
		            if (id === 'footer-version') {
		              el.textContent = `Versi: ${appStatus.latest_version}`;
		            } else {
		              el.textContent = id === 'latest-version'
		                ? appStatus.latest_version
		                : `Versi ${appStatus.latest_version}`;
		            }
		            el.classList.remove('hidden');
		          }
		        });
		        if (versionBadge) versionBadge.classList.remove('hidden');
		      }

		      // ── Ukuran File ───────────────────────────────────────────────────
		      if (appStatus.file_size) {
		        const sizeText = document.getElementById('hero-filesize-text');
		        const sizeTooltip = document.getElementById('hero-filesize-tooltip');
		        const bottomSize = document.getElementById('bottom-filesize-text');
		        const downloadSize = document.getElementById('file-size');
		        const downloadSizeContainer = document.getElementById('file-size-container');

		        if (sizeText) sizeText.textContent = appStatus.file_size;
		        if (sizeTooltip) sizeTooltip.classList.remove('!hidden');
		        if (bottomSize) {
		          bottomSize.textContent = `• Ukuran file ${appStatus.file_size}`;
		          bottomSize.classList.remove('hidden');
		        }
		        if (downloadSize) downloadSize.textContent = appStatus.file_size;
		        if (downloadSizeContainer) downloadSizeContainer.classList.remove('hidden');
		      }

		    } catch (err) {
		      console.warn('[Realtime] Gagal sync data:', err);
		    }
		  }

		  // Jalankan keduanya segera saat halaman load — paralel, tidak saling tunggu
		  syncDynamicData(true);
		  updateServerStatus();

		  // Polling setiap 60 detik → perubahan admin tampil dalam < 1 menit
		  const POLL_INTERVAL = 60 * 1000;
		  setInterval(() => {
		    syncDynamicData(true);
		    updateServerStatus();
		  }, POLL_INTERVAL);

		  // Update juga saat user kembali ke tab (misal: dari tab lain atau minimize)
		  document.addEventListener('visibilitychange', () => {
		    if (document.visibilityState === 'visible') {
		      syncDynamicData(true);
		      updateServerStatus();
		    }
		  });
		</script>
	</body>
</html>
